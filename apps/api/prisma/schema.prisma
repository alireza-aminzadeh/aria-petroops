generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users             User[]
  sites             Site[]
  workOrders        WorkOrder[]
  maintenancePlans  MaintenancePlan[]
  auditLogs         AuditLog[]
  anomalyEvents     AnomalyEvent[]
  alarmEvents       AlarmEvent[]
  energyMeters      EnergyMeter[]
  aiQueryLogs       AiQueryLog[]
  integrationDeliveries IntegrationDelivery[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  roles        Json     @default("[]")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                   Tenant            @relation(fields: [tenantId], references: [id])
  assignedWorkOrders       WorkOrder[]       @relation("AssignedWorkOrders")
  createdWorkOrders        WorkOrder[]       @relation("CreatedWorkOrders")
  assignedMaintenancePlans MaintenancePlan[] @relation("AssignedMaintenancePlans")

  @@index([tenantId])
  @@map("users")
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  location  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  units  Unit[]

  @@index([tenantId])
  @@map("sites")
}

model Unit {
  id          String @id @default(uuid()) @db.Uuid
  siteId      String @map("site_id") @db.Uuid
  name        String
  processType String @map("process_type")

  site         Site         @relation(fields: [siteId], references: [id])
  equipment    Equipment[]
  energyMeters EnergyMeter[]

  @@index([siteId])
  @@map("units")
}

model Equipment {
  id             String @id @default(uuid()) @db.Uuid
  unitId         String @map("unit_id") @db.Uuid
  tagNumber      String @unique @map("tag_number")
  name           String
  equipmentClass String @map("equipment_class")
  criticality    String

  unit             Unit              @relation(fields: [unitId], references: [id])
  tags             Tag[]
  workOrders       WorkOrder[]
  maintenancePlans MaintenancePlan[]
  anomalyEvents    AnomalyEvent[]
  alarmEvents      AlarmEvent[]
  energyMeters     EnergyMeter[]

  @@index([unitId])
  @@map("equipment")
}

model Tag {
  id            String @id @default(uuid()) @db.Uuid
  equipmentId   String @map("equipment_id") @db.Uuid
  tagName       String  @unique @map("tag_name")
  unitOfMeasure String  @map("unit_of_measure")
  dataType      String  @default("numeric") @map("data_type")
  alarmLl       Float?  @map("alarm_ll")
  alarmLo       Float?  @map("alarm_lo")
  alarmHi       Float?  @map("alarm_hi")
  alarmHh       Float?  @map("alarm_hh")

  equipment      Equipment       @relation(fields: [equipmentId], references: [id])
  readings       SensorReading[]
  anomalyEvents  AnomalyEvent[]
  alarmEvents    AlarmEvent[]
  energyMeters   EnergyMeter[]

  @@index([equipmentId])
  @@map("tags")
}

model SensorReading {
  time    DateTime @map("time") @db.Timestamptz(6)
  tagId   String   @map("tag_id") @db.Uuid
  value   Float
  quality Int      @default(0) @db.SmallInt

  tag Tag @relation(fields: [tagId], references: [id])

  @@id([time, tagId])
  @@index([tagId, time])
  @@map("sensor_readings")
}

model WorkOrder {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  equipmentId      String   @map("equipment_id") @db.Uuid
  status           String   @default("draft")
  priority         String   @default("medium")
  description      String
  assignedToId     String?  @map("assigned_to") @db.Uuid
  createdById      String?  @map("created_by") @db.Uuid
  machineSnapshot  Json?    @map("machine_snapshot")
  rejectionReason  String?  @map("rejection_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  equipment  Equipment  @relation(fields: [equipmentId], references: [id])
  assignedTo User?      @relation("AssignedWorkOrders", fields: [assignedToId], references: [id])
  createdBy  User?      @relation("CreatedWorkOrders", fields: [createdById], references: [id])

  @@index([tenantId, status])
  @@index([equipmentId])
  @@map("work_orders")
}

model MaintenancePlan {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  equipmentId    String    @map("equipment_id") @db.Uuid
  planType       String    @map("plan_type")
  frequencyDays  Int?      @map("frequency_days")
  status         String    @default("draft")
  nextDueAt      DateTime? @map("next_due_at") @db.Date
  // فیلدهای موتور زمان‌بندی heuristic (نت/TAR) — همه اختیاری تا CRUD قدیمی
  // (بدون این مقادیر) هم‌چنان کار کند؛ فقط با فراخوانی POST /maintenance-plans/schedule پر می‌شوند.
  estimatedHours Float?    @map("estimated_hours")
  assignedToId   String?   @map("assigned_to_id") @db.Uuid
  scheduledStart DateTime? @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd   DateTime? @map("scheduled_end") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  equipment  Equipment @relation(fields: [equipmentId], references: [id])
  assignedTo User?     @relation("AssignedMaintenancePlans", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([tenantId, scheduledStart])
  @@map("maintenance_plans")
}

model AnomalyEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  tagId              String?   @map("tag_id") @db.Uuid
  equipmentId        String?   @map("equipment_id") @db.Uuid
  detectedAt         DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  score              Float?
  status             String    @default("open")
  method              String    @default("isolation_forest")
  summary            String?
  contributors       Json      @default("[]")
  acknowledgedAt     DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  notifiedSafeopsAt  DateTime? @map("notified_safeops_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  tag       Tag?       @relation(fields: [tagId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([tenantId, status])
  @@index([equipmentId, detectedAt])
  @@map("anomaly_events")
}

model AlarmEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tagId       String    @map("tag_id") @db.Uuid
  equipmentId String    @map("equipment_id") @db.Uuid
  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  clearedAt   DateTime? @map("cleared_at") @db.Timestamptz(6)
  priority    String
  alarmType   String    @map("alarm_type")
  state       String    @default("active")
  value       Float
  message     String

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tag       Tag       @relation(fields: [tagId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([tenantId, startedAt])
  @@index([tagId, state])
  @@map("alarm_events")
}

model EnergyMeter {
  id                    String @id @default(uuid()) @db.Uuid
  tenantId              String @map("tenant_id") @db.Uuid
  unitId                String? @map("unit_id") @db.Uuid
  equipmentId           String? @map("equipment_id") @db.Uuid
  tagId                 String? @map("tag_id") @db.Uuid
  code                  String  @unique
  name                  String
  kind                  String
  unitOfMeasure         String  @map("unit_of_measure")
  emissionFactorKgCo2e Float   @map("emission_factor_kg_co2e")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  unit      Unit?      @relation(fields: [unitId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  tag       Tag?       @relation(fields: [tagId], references: [id])
  readings  EnergyReading[]

  @@index([tenantId])
  @@map("energy_meters")
}

model EnergyReading {
  time    DateTime @map("time") @db.Timestamptz(6)
  meterId String   @map("meter_id") @db.Uuid
  value   Float

  meter EnergyMeter @relation(fields: [meterId], references: [id])

  @@id([time, meterId])
  @@index([meterId, time])
  @@map("energy_readings")
}

model IntegrationDelivery {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  target     String
  eventType  String    @map("event_type")
  payload    Json
  status     String    @default("pending")
  attempts   Int       @default(0)
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("integration_deliveries")
}

model AiQueryLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  queryText    String   @map("query_text")
  responseText String?  @map("response_text")
  status       String   @default("unavailable")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("ai_query_log")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id")
  action    String
  actorId   String?  @map("actor_id") @db.Uuid
  payload   Json     @default("{}")
  prevHash  String   @map("prev_hash") @db.VarChar(64)
  hash      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entity, entityId])
  @@map("audit_log")
}
