# =====================================================================
# Aria PetroOps — نمونهٔ متغیرهای محیطی
# این فایل را کپی کنید به .env و مقادیر واقعی را پر کنید.
# .env هرگز نباید commit شود (در .gitignore قرار دارد).
# =====================================================================

# ---- Demo / bootstrap users (seed) ----
# admin@petro.aria-ai.ir / ChangeMe!Admin1
# planner@petro.aria-ai.ir / ChangeMe!Planner1
# tech@petro.aria-ai.ir / ChangeMe!Tech1
#
# کاربر راه‌انداز مشترک هر دو سامانه:
#   نام کاربری: alireza
#   لوکال (ARIA_RUNTIME خالی یا local): alireza
#   Production: رمز را با SEED_ALIREZA_PASSWORD روی سرور بگذارید (در git نیست)
# برای بازنویسی رمز، مقدار زیر را پر کنید:
# SEED_ALIREZA_PASSWORD=

# ---- App ----
NODE_ENV=production
PORT=3000
APP_URL=https://petro.aria-ai.ir
IMAGE_TAG=latest

# ---- Database (PostgreSQL 16 + TimescaleDB) ----
POSTGRES_DB=aria_petroops
POSTGRES_USER=aria_petroops
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# ---- سخت‌سازی RLS: نقش اجرایی محدود پایگاه‌داده (لایهٔ دوم دفاعی، اختیاری ولی توصیه‌شده) ----
# POSTGRES_USER بالا همیشه سوپریوزر migration است (BYPASSRLS دارد، پس اگر برنامه
# هم با همان وصل شود RLS عملاً بی‌اثر است). اگر این سه مقدار پر شوند، در هر
# deploy یک نقش Postgres محدود (بدون سوپریوزر/BYPASSRLS) خودکار ساخته/همگام
# می‌شود (infra/docker/api-prod.sh -> prisma/provision-app-role.js) و برنامه
# (نه migration) با APP_DATABASE_URL وصل می‌شود تا پالیسی‌های RLS واقعاً روی
# کوئری‌های runtime اعمال شوند. خالی گذاشتن این‌ها رفتار قبلی (بدون سخت‌سازی
# نقش، فقط فیلتر tenantId در کد) را حفظ می‌کند — هیچ deploy موجودی نمی‌شکند.
APP_DB_ROLE=aria_petroops_app
APP_DB_PASSWORD=
APP_DATABASE_URL="postgresql://${APP_DB_ROLE}:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=5"

# ---- Redis (کش + BullMQ) ----
# طبق قاعدهٔ امنیتی پروژه: Redis همیشه باید رمز داشته باشد و هرگز به 0.0.0.0 اکسپوز نشود
REDIS_PASSWORD=changeme-strong-password
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"

# ---- JWT Auth ----
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---- AI Gateway ----
# true = Isolation Forest + RUL مهندسی + دانش محلی روی همین سرور
# اگر AI_GATEWAY_URL پر شود، درخواست‌ها به سرویس مرکزی FastAPI می‌روند
AI_GATEWAY_ENABLED=true
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_MS=8000

# ---- MQTT / Edge (فاز ۲) ----
# بروکر فقط داخل Docker است؛ هرگز پورت MQTT را به 0.0.0.0 ندهید
INDUSTRIAL_INGESTION_ENABLED=true
MQTT_BROKER_URL=mqtt://mqtt:1883
MQTT_USERNAME=petroops
MQTT_PASSWORD=changeme-mqtt-password
# OPC-UA فقط‌خواندنی از Edge Agent (خالی = شبیه‌ساز واحد نمونه)
OPCUA_ENDPOINT_URL=
OPCUA_NODE_MAP={}
MODBUS_HOST=
EDGE_INTERVAL_MS=2000

# ---- اتصال به SafeOps (ایمن‌کار) ----
# در Production بعد از کپی PETROOPS_INTEGRATION_KEY روی hse، این‌ها را true کنید.
SAFEOPS_ENABLED=false
SAFEOPS_API_URL=https://hse.aria-ai.ir
SAFEOPS_API_KEY=
SAFEOPS_TIMEOUT_MS=8000

# ---- WebSocket Gateway ----
WS_CORS_ORIGIN=https://petro.aria-ai.ir
