# =====================================================================
# Aria PetroOps — نمونهٔ متغیرهای محیطی
# این فایل را کپی کنید به .env و مقادیر واقعی را پر کنید.
# .env هرگز نباید commit شود (در .gitignore قرار دارد).
# =====================================================================

# ---- Demo / bootstrap users (seed) ----
# admin@petro.aria-ai.ir / ChangeMe!Admin1
# planner@petro.aria-ai.ir / ChangeMe!Planner1
# tech@petro.aria-ai.ir / ChangeMe!Tech1
#
# کاربر راه‌انداز مشترک هر دو سامانه:
#   نام کاربری: alireza
#   لوکال (ARIA_RUNTIME خالی یا local): alireza
#   Production (ARIA_RUNTIME=production در docker-compose.yml): Aria7x!Alireza#Ops2026
# برای بازنویسی رمز، مقدار زیر را پر کنید:
# SEED_ALIREZA_PASSWORD=

# ---- App ----
NODE_ENV=production
PORT=3000
APP_URL=https://petro.aria-ai.ir
IMAGE_TAG=latest

# ---- Database (PostgreSQL 16 + TimescaleDB) ----
POSTGRES_DB=aria_petroops
POSTGRES_USER=aria_petroops
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# ---- Redis (کش + BullMQ) ----
# طبق قاعدهٔ امنیتی پروژه: Redis همیشه باید رمز داشته باشد و هرگز به 0.0.0.0 اکسپوز نشود
REDIS_PASSWORD=changeme-strong-password
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"

# ---- JWT Auth ----
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---- AI Gateway (Placeholder — عمداً غیرفعال، پیاده‌سازی نشده) ----
# جزئیات کامل در docs/06-ai-gateway-placeholder.md
AI_GATEWAY_ENABLED=false
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_MS=8000

# ---- پروتکل‌های صنعتی (Placeholder — فاز ۲+، غیرفعال) ----
INDUSTRIAL_INGESTION_ENABLED=false
MQTT_BROKER_URL=
OPCUA_ENDPOINT_URL=
MODBUS_HOST=

# ---- WebSocket Gateway ----
WS_CORS_ORIGIN=https://petro.aria-ai.ir
